# ===== LLM 提供商（推荐 DeepSeek 官方） =====

# DeepSeek 官方：填入 https://platform.deepseek.com 申请的 API Key 即可
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# OpenRouter（备选，需要 OPENAI_API_KEY）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=deepseek/deepseek-v4-flash

# LLM 调优（可选）
# LLM 首个 token 超时毫秒数；DeepSeek 官方建议调大，默认 10000
LLM_FIRST_TOKEN_TIMEOUT_MS=10000
# LLM 单次回复最大 token 数，默认 512
LLM_MAX_TOKENS=512

# ===== Twilio =====
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ===== 工作台管理 =====
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=

# ===== 部署 =====
DOMAIN=
PORT=8080
