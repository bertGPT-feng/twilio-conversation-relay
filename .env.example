# ===== LLM 提供商（推荐 DeepSeek 官方） =====

# DeepSeek 官方：填入 https://platform.deepseek.com 申请的 API Key 即可
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# OpenRouter（备选，需要 OPENAI_API_KEY）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=deepseek/deepseek-v4-flash

# ===== Twilio =====
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ===== 工作台管理 =====
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=

# ===== 部署 =====
DOMAIN=
PORT=8080
